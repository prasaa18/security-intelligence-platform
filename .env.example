# Required MongoDB credentials for the private Docker network
MONGO_INITDB_ROOT_USERNAME=replace-with-a-database-admin-name
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-long-random-database-password

# Required token used by GitHub Actions, GitLab, Jenkins, or direct scan uploads
SCAN_INGESTION_TOKEN=replace-with-a-long-random-integration-token

# Required UI access for the Docker secure profile
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
APP_VIEWER_USERNAME=viewer
APP_VIEWER_PASSWORD=replace-with-a-long-random-viewer-password

# Optional AI and notification settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MAIL_ENABLED=false
MAIL_FROM=security-platform@example.com

# Only required when starting the optional mongo-express tools profile
MONGO_EXPRESS_USERNAME=replace-with-a-tools-username
MONGO_EXPRESS_PASSWORD=replace-with-a-long-random-tools-password