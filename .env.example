# Required MongoDB credentials for the private Docker network
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=StrongPass123!

# Required token used by GitHub Actions, GitLab, Jenkins, or direct scan uploads
SCAN_INGESTION_TOKEN=change-me-please

# Required UI access for the Docker secure profile
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=ChangeMeStrongAdmin123!
APP_VIEWER_USERNAME=viewer
APP_VIEWER_PASSWORD=ChangeMeStrongViewer123!

# Optional AI and notification settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MAIL_ENABLED=false
MAIL_FROM=security-platform@example.com

# Only required when starting the optional mongo-express tools profile
MONGO_EXPRESS_USERNAME=mongoexpress
MONGO_EXPRESS_PASSWORD=ChangeMeStrongMongoExpress123!
